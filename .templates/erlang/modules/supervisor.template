-module({{FILE}}).
-behaviour(supervisor).

%% API
-export([
	start_link/0
]).

%% Callbacks
-export([init/1]).

-define(SERVER, ?MODULE).

%%%===================================================================
%%% api
%%%===================================================================

-spec start_link() -> supervisor:startlink_ret().
start_link() ->
    supervisor:start_link({local, ?SERVER}, ?MODULE, []).

%%%===================================================================
%%% supervisor
%%%===================================================================

init([]) ->
    SupFlags = #{strategy => one_for_all,
                 intensity => 1,
                 period => 5},
    ChildSpecs = [],
    {ok, {SupFlags, ChildSpecs}}.

